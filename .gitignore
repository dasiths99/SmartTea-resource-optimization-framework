# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environment
.venv/
venv/

# Secrets / local config
.env

# Local databases (SQLite during development)
*.db
*.sqlite3

# Trained models and run outputs (regenerate from scripts)
artifacts/*
!artifacts/.gitkeep

# Rebuild / regeneration outputs (compare, then delete)
data/interim/real_rebuilt/
data/processed/*_regen/
data/archive/*_regen/

# One-file Excel release: a 33 MB copy of the CSVs, rebuild with python -m src.data.build_workbook
data/release/

# Java / Spring Boot (backend/)
backend/target/
backend/build/
backend/.gradle/
*.class
*.log

# Node / React (frontend/)
node_modules/
frontend/dist/
frontend/build/

# Archives / backups of the project (GitHub rejects files over 100 MB)
*.rar
*.zip
*.7z

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
